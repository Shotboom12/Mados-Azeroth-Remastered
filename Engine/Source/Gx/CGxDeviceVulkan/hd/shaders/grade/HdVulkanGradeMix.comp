// HD: blend the small LUTs, not two differently graded full-screen images.
#version 450
layout(local_size_x=8,local_size_y=8)in;
layout(binding=0)uniform sampler2D sources[16];
layout(rgba16f,binding=1)uniform writeonly image2D mixedLut;
layout(push_constant)uniform Weights{vec4 weights[4];}c;
void main(){ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,imageSize(mixedLut))))return;vec4 v=vec4(0);
 if(c.weights[0][0]>0)v+=texelFetch(sources[0],p,0)*c.weights[0][0];
 if(c.weights[0][1]>0)v+=texelFetch(sources[1],p,0)*c.weights[0][1];
 if(c.weights[0][2]>0)v+=texelFetch(sources[2],p,0)*c.weights[0][2];
 if(c.weights[0][3]>0)v+=texelFetch(sources[3],p,0)*c.weights[0][3];
 if(c.weights[1][0]>0)v+=texelFetch(sources[4],p,0)*c.weights[1][0];
 if(c.weights[1][1]>0)v+=texelFetch(sources[5],p,0)*c.weights[1][1];
 if(c.weights[1][2]>0)v+=texelFetch(sources[6],p,0)*c.weights[1][2];
 if(c.weights[1][3]>0)v+=texelFetch(sources[7],p,0)*c.weights[1][3];
 if(c.weights[2][0]>0)v+=texelFetch(sources[8],p,0)*c.weights[2][0];
 if(c.weights[2][1]>0)v+=texelFetch(sources[9],p,0)*c.weights[2][1];
 if(c.weights[2][2]>0)v+=texelFetch(sources[10],p,0)*c.weights[2][2];
 if(c.weights[2][3]>0)v+=texelFetch(sources[11],p,0)*c.weights[2][3];
 if(c.weights[3][0]>0)v+=texelFetch(sources[12],p,0)*c.weights[3][0];
 if(c.weights[3][1]>0)v+=texelFetch(sources[13],p,0)*c.weights[3][1];
 if(c.weights[3][2]>0)v+=texelFetch(sources[14],p,0)*c.weights[3][2];
 if(c.weights[3][3]>0)v+=texelFetch(sources[15],p,0)*c.weights[3][3];
 imageStore(mixedLut,p,v);}
