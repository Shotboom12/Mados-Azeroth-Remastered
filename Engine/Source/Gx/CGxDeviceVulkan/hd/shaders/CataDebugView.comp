// HD: hdCataDebug's picture-in-picture (CataWaterService.cpp), a BeforeUi stage: the scene copied at
// BeforeLiquids (CaptureScene.comp), drawn into the lower right third of the frame. Mode 1 shows its colour,
// mode 2 its depth, linearized with the world's projection (white near, black at depthParams2.x; the cleared
// sky in dark blue, so a copy that lost the depth shows at once).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform image2D frame;   // the stage's frame: the back buffer's bytes
layout(set = 0, binding = 1) uniform sampler2D copiedColor;   // true RGBA (CaptureScene.comp swapped it)
layout(set = 0, binding = 2) uniform sampler2D copiedDepth;   // raw depth, R32F
layout(push_constant) uniform Push {
    ivec2 origin;        // the inset's top left, in frame pixels
    ivec2 size;          // the inset's size
    uint  mode;          // 1 colour, 2 depth
    uint  swapRB;        // the frame's channel order
    vec2  pad;
    vec4  depthParams;   // viewport minDepth, maxDepth, projection[2][2], projection[3][2]
    vec4  depthParams2;  // x: the view depth shown black
} pc;

void main()
{
    const ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(local, pc.size))) return;
    const ivec2 pos = pc.origin + local;
    vec4 c;
    if (any(lessThan(local, ivec2(2))) || any(greaterThanEqual(local, pc.size - ivec2(2)))) {
        c = vec4(1.0);   // the border
    } else {
        const vec2 uv = (vec2(local) + 0.5) / vec2(pc.size);
        if (pc.mode == 2u) {
            const float d = textureLod(copiedDepth, uv, 0.0).r;
            if (d >= pc.depthParams.y * 0.99999) {
                c = vec4(0.05, 0.05, 0.3, 1.0);   // nothing drawn there (the sky, or a lost depth)
            } else {
                const float zc = (d - pc.depthParams.x) / max(pc.depthParams.y - pc.depthParams.x, 1e-6);
                // D3D: zc = P22 + P32 / z with P32 < 0, so zc - P22 is negative in front of the camera.
                const float den = zc - pc.depthParams.z;
                const float z = pc.depthParams.w / (abs(den) > 1e-7 ? den : -1e-7);   // view depth
                const float g = 1.0 - clamp(z / max(pc.depthParams2.x, 1.0), 0.0, 1.0);
                c = vec4(g, g, g, 1.0);
            }
        } else {
            c = vec4(textureLod(copiedColor, uv, 0.0).rgb, 1.0);
        }
    }
    imageStore(frame, pos, pc.swapRB != 0u ? c.bgra : c);
}
